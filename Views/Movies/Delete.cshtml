@model Mission06_DeMann.Models.Movie

@{
    ViewData["Title"] = "Delete Movie";
}

<h2>@ViewData["Title"]</h2>

<h3>Are you sure you want to delete the movie "@Model.Title"?</h3>

<form asp-action="Delete">
    <div class="form-group">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a href="@Url.Action("Index", "Movies")" class="btn btn-secondary">Cancel</a>
    </div>
</form>