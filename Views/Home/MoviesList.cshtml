@model IEnumerable<Mission06_DeMann.Models.Movie>

@{
    ViewData["Title"] = "Movies List";
}

<h1>Movies List</h1>

<table class="table">
    <thead>
    <tr>
        <th>Title</th>
        <th>Year</th>
        <th>Edited</th>
        <th>Copied to Plex</th>
        <th>Director</th>
        <th>Category</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var movie in Model)
    {
        <tr>
            <td>@movie.Title</td>
            <td>@movie.Year</td>
            <td>@movie.Edited</td>
            <td>@movie.CopiedToPlex</td>
            <td>@movie.Director</td>
            <td>@movie.Category</td>
            <td>
                <a href="@Url.Action("Edit", new { id = movie.MovieId })">Edit</a> |
                <a href="@Url.Action("Delete", new { id = movie.MovieId })">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>